//class for moves
class Move
{
protected:
string name;
int power;
string type;
public:
    Move(string mName, int pow, string mType) : name(mName), power(pow), type(mType){} // constructor
    ~Move() // deconstructor 
    {}
    // functions accessing this class
    // get name
    string getname()
    {
        return name;
    }
    // get power/damage
    int getPow()
    {
        return power;
    }
    // get type
    string getType()
    {
        return type;
    }
    
};

// pokemon class - base class
class Pokemon
{
protected:
    string name;
    int hp;
    int level;
    
public:
   Pokemon(string pName, int hP, int lev , vector<Move> moves) : name(pName), hp(hP), moveset(moves){} // constructor
   vector<Move> moveset;
    
   // functions accessing this class
   string getname()
    {
        return name;
    }
    
   int getHP()
   {
       return hp;
   }
   
   // function to display moveset
   void displayMoves()
   {
       cout << endl;
       cout << "Pick a move for " << name << endl;
       cout << " " << endl;
       for (int i=0; i < moveset.size(); i++)
       {
           cout << i + 1 << ". " << moveset[i].getname() << " Power: " << moveset[i].getPow() << " Type: " << moveset[i].getType() << endl;
       }
       }
   
   // function to use move
   void useMove(int i, Pokemon& op)
   {
       Move moveChoice = moveset[i - 1];
       int damage = moveChoice.getPow();
       op.takeDamage(damage);
       
       // Pokemon uses move for how much damage
       cout << name << " used " << moveChoice.getname() << " against " << op.getname() << " dealing " << damage << "!" << endl;
       
   }
   
   // function to take damage
   void takeDamage(int damage)
   {
       hp-= damage;
       
       // validate hp cannot go under 0
       if (hp < 0) 
           hp = 0;
   }
   // check if Pokemon has fainted
   bool checkStatus()
   {
       return hp > 0;
   }
   
   // get move set for opponent
   vector<Move> &getmovePool()
   {
       return moveset;
   }
   
   virtual ~Pokemon() // virtual deconstructor
   {}
}; 

