// movepool for opponent pokemon
vector<Move> randomizeMoves()
{
    // Move pool for opponents
    vector<Move> movePool =
    {
    Move("Tackle", 40, "Normal"),
    Move("Pound", 40, "Normal"),
    Move("Scratch", 40, "Normal"),
    Move("Stomp", 65, "Normal"),
    Move("Gust", 40, "Flying"),
    Move("Mega Punch", 80, "Normal"),
    Move("Thunder Punch", 75, "Electric"),
    Move("Bite", 60, "Dark"),
    Move("Bubble Beam", 65, "Water"),
    Move("Psybeam", 65, "Psychic"),
    Move("Double Kick", 30, "Fighting"),
    Move("Headbutt", 70, "Normal"),
    Move("Ember", 40, "Fire"),
    Move("Rock Throw", 50, "Rock"),
    Move("Dig", 80, "Ground"),
    Move("Quick Attack", 40, "Normal"),
    };
    
    // randomize
    vector<Move> randomMove;
    int randomize = rand() % 4; 
    
    for (int i = 0; i < randomize; i++) 
    {
        int count = rand() % movePool.size();
        randomMove.push_back(movePool[count]);
    }

    return randomMove;
  }

// randomize opponent
Pokemon randomPoke()
{
    // vector holding pokemon names
    vector<string> pokeNames = {"Caterpie", "Eevee", "Geodude", "Pidgey", "Ponyta", "Rattata", "Vulpix", "Weedle", "Snorlax", " Psyduck"};
    
    // randomize
    int randomOpponent = rand() % pokeNames.size();
    
    // random move pool
    vector<Move> opponentMoves = randomizeMoves();
    // return
    return Pokemon(pokeNames[randomOpponent], 100, 10, opponentMoves);
}
  
// battle function
void Battle(Pokemon &playerP, Pokemon &opponentP)
{
    int choice; // move choice
    
    // player goes first
    playerP.displayMoves();
    cout << "Pick a move for " << playerP.getname() << endl;
    cin >> choice;
    
    // attack
    playerP.useMove(choice, opponentP);
    
     // check if user has fainted
    if (!playerP.checkStatus()) 
    {
        cout << playerP.getname() << " has fainted!" << endl;
        cout << opponentP.getname() << " wins!" << endl;
        }
    
     // computer player (opponent) turn
    int OPchoice = rand() % opponentP.getmovePool().size();
    // attack
    opponentP.useMove(OPchoice, playerP);
    
    
    // check if opponent has fainted
    if (!opponentP.checkStatus())
    {
        cout << opponentP.getname() << " has fainted!" << endl;
        cout << playerP.getname() << " wins!" << endl;
    }
    
} 
